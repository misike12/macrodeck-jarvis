<Project>

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>true</ImplicitUsings>
        <AnalysisLevel>latest-recommended</AnalysisLevel>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <WarningsAsErrors>CS8602</WarningsAsErrors>
        <!-- Documentation is generated so the compiler checks the doc comments themselves: a mismatched or
             unclosed tag is otherwise invisible, and the repository's rule is that a comment states a
             constraint rather than narrating a bug. CS1591 is excluded because not every member here needs
             a comment, and requiring one would be decoration rather than documentation. -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>

</Project>
