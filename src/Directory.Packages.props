<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <!-- The floating 3.0.0-* range resolves to whatever NuGet ranks highest, which is 3.0.0-preview.10.
             preview predates beta in SemVer ordering, so the float lands on an older SDK than the CLI that
             builds against it, and newer contracts (SupportsFlows, AppearanceProperties, UiModifier)
             simply do not exist. Pin the newest beta and override it with
             -p:MacroDeckSdkVersion=<version> to test against another build. -->
    <MacroDeckSdkVersion Condition="'$(MacroDeckSdkVersion)' == ''">3.0.0-beta.15</MacroDeckSdkVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="MacroDeck.Localization" Version="$(MacroDeckSdkVersion)" />
    <PackageVersion Include="MacroDeck.Plugin.Analyzers" Version="$(MacroDeckSdkVersion)" />
    <PackageVersion Include="MacroDeck.Plugin.Hosting" Version="$(MacroDeckSdkVersion)" />
    <PackageVersion Include="MacroDeck.Plugin.Serilog" Version="$(MacroDeckSdkVersion)" />
    <PackageVersion Include="MacroDeck.Plugin.Testing" Version="$(MacroDeckSdkVersion)" />
    <PackageVersion Include="MacroDeck.Sdk" Version="$(MacroDeckSdkVersion)" />
    <PackageVersion Include="Microsoft.ML.OnnxRuntime" Version="1.30.0" />
    <PackageVersion Include="NAudio" Version="3.1.0" />
    <PackageVersion Include="NAudio.Wasapi" Version="3.1.0" />
    <PackageVersion Include="System.Drawing.Common" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup>
    <PackageVersion Include="System.ServiceProcess.ServiceController" Version="10.0.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.0" />
    <PackageVersion Include="NUnit" Version="4.3.2" />
    <PackageVersion Include="NUnit.Analyzers" Version="4.7.0" />
    <PackageVersion Include="NUnit3TestAdapter" Version="5.0.0" />
  <PackageVersion Include="SkiaSharp" Version="4.151.1" />
  </ItemGroup>
</Project>
