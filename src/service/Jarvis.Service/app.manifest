<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="Jarvis.Service" />

  <!--
    asInvoker is correct here, and it is not a leftover.

    This manifest describes what Windows should do when a person starts the binary. Started by the service
    control manager, Windows supplies the LocalSystem token and this file is not consulted at all: the SCM
    does not honour requestedExecutionLevel, so nothing here can elevate or de-elevate the service. Started
    from a desktop, asInvoker is also correct, because tray mode is meant to run as the signed-in user.

    Changing this to requireAdministrator would therefore not give the service any rights it does not
    already have, and would turn every tray launch into a UAC prompt for no benefit. The registry work the
    service does is authorised by which account the SCM runs it as, not by this element.
  -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <!--
    Windows 10 and 11. Declared so the tray icon and the common controls are the modern ones rather than
    the 1990s versions a missing entry produces.
  -->
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}" />
      <supportedOS Id="{4a2f28e3-53b9-4441-ba9c-d69d4a4a6e38}" />
      <supportedOS Id="{35138b9a-5d96-4fbd-8e2d-a2440225f93a}" />
      <supportedOS Id="{e2011457-1546-43c5-a5fe-008deee3d3f0}" />
    </application>
  </compatibility>

  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <!-- DPI awareness is set by ApplicationHighDpiMode in the project, which is where WinForms reads
           it from. Declaring it here as well produces a build warning and no effect. -->
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
    </windowsSettings>
  </application>
</assembly>
