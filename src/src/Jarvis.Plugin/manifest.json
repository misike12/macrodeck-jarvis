{
  "$schema": "https://schemas.macro-deck.app/plugin-manifest-v1.schema.json",
  "manifestVersion": 1,
  "id": "com.misike12.jarvis",
  "name": "JARVIS",
  "version": "1.1.6",
  "description": "A voice-driven assistant for your deck.",
  "icon": "Assets/icon.svg",
  "entrypoints": {
    "win-x64": {
      "executable": "runtimes/win-x64/Jarvis.Plugin.dll",
      "runtime": {
        "kind": "FrameworkDependent",
        "dotnetVersion": "10.0"
      }
    }
  },
  "publisher": {
    "name": "misike12"
  },
  "license": "MIT",
  "repository": "https://github.com/misike12/macrodeck-jarvis",
  "homepage": "https://github.com/misike12/macrodeck-jarvis",
  "compatibility": {
    "macroDeck": ">=3.0.0-0"
  },
  "ai": {
    "interaction": true,
    "generatedContent": true,
    "generatedAssets": false,
    "services": [
      "NVIDIA NIM"
    ]
  },
  "permissions": [
    "net:outbound",
    "fs:user-files",
    "process:spawn",
    "events:publish",
    "host:notifications",
    "host:widgets"
  ],
  "services": {
    "elevated": {
      "summary": "JARVIS can use a separate Windows service that runs as LocalSystem for machine-wide operations.",
      "executable": "Jarvis Service.exe",
      "installScript": "scripts/install-service.ps1",
      "uninstallScript": "scripts/uninstall-service.ps1",
      "pipe": "jarvis-service",
      "grantedTo": "the account that ran the install script, plus SYSTEM and Administrators",
      "writes": "HKLM\\SOFTWARE\\Jarvis and keys below it, and only those",
      "optional": true
    }
  }
}