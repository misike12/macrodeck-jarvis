<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <!-- Windows-specific because it references the service, which uses Windows Forms and the service
             control manager. -->
        <TargetFramework>net10.0-windows</TargetFramework>
        <!-- Underscored test names, like the Macro Deck repository's own test projects. -->
        <NoWarn>$(NoWarn);CA1707</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="MacroDeck.Plugin.Testing" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="NUnit" />
        <PackageReference Include="NUnit.Analyzers" PrivateAssets="all" />
        <PackageReference Include="NUnit3TestAdapter" />
    </ItemGroup>

<ItemGroup>
        <ProjectReference Include="..\..\src\Jarvis.Plugin\Jarvis.Plugin.csproj" />
        <!-- The service is referenced so its protocol and its guards can be tested directly. It targets
             net10.0-windows, which is why this project does too. -->
        <ProjectReference Include="..\..\service\Jarvis.Service\Jarvis.Service.csproj" />
    </ItemGroup>

<ItemGroup>
        <PackageReference Include="NAudio.Wasapi" />
        <!-- Only to decode the orb's GIF in a test. The orb is the one image this plugin draws, and it
             draws it with a hand-written encoder, so the encoder is checked against a real decoder
             rather than against itself. -->
        <PackageReference Include="SkiaSharp" />
    </ItemGroup>
</Project>
